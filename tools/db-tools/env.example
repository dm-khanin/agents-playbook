# db-tools profiles, one setting per line: <PROFILE>_<SETTING>=<value>. Copy to ~/.config/db-tools/.env and
# chmod 600 it. Values are taken literally (no expansion); one pair of surrounding quotes is removed. A setting
# already in the environment wins over this file. Lines that are not profile settings are ignored.
#
# Give every profile an account that can only read: the wrappers are a second layer, not the boundary.

# PostgreSQL: pg-query.sh, refresh-schema.sh. Percent-encode ? / # and % in the password, or leave the password
# out and keep it in ~/.pgpass.
STAGING_PG_URI=postgresql://<user>:<password>@db.staging.example.com:5432/app?sslmode=require

# MongoDB: mongo-query.sh, mongo-explain.sh, refresh-schema.sh. A user with only the read role.
STAGING_MONGO_URI=mongodb+srv://<user>:<password>@cluster0.example.net/app?retryWrites=true

# Elasticsearch: es-query.sh. An endpoint, ES_URL (which may embed user:password) or ES_CLOUD_ID, and a
# credential, ES_API_KEY (id:key or its base64) or ES_CREDENTIAL, which is tried as an API key and then as
# user:password unless ES_AUTH says apikey or basic.
STAGING_ES_URL=https://search.staging.example.com:9243
STAGING_ES_API_KEY=<id>:<key>
# STAGING_ES_CREDENTIAL=<user>:<password>
# STAGING_ES_AUTH=basic

# Redis or a Redis-compatible store: redis-query.sh. rediss:// for TLS.
STAGING_REDIS_URI=rediss://<user>:<password>@cache.staging.example.com:6380
