<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd does not expand ~ or $HOME: the install step replaces __HOME__ with your home directory. -->
<plist version="1.0"><dict>
  <key>Label</key><string>local.keep-scratchpads</string>
  <key>ProgramArguments</key><array><string>__HOME__/.agents/tools/keep-scratchpads/keep-scratchpads.sh</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><true/>
</dict></plist>
